---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'sha256-hash-for-inlines'; style-src 'self' 'unsafe-inline';">
    <link rel="manifest" href="/manifest.json">
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/tailwind.css">
  </head>
  <body>
    <header class="bg-bg-element p-4">
      <nav>
        <a href="/">Home</a> | <a href="/methodology">Methodology</a> | <a href="/explorer">Explorer</a> | <a href="/changelog">Changelog</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>