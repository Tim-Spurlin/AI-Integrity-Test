{
  "name": "ai-integrity-test",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev & cargo watch -x 'build --target wasm32-unknown-unknown'",
    "build": "cargo build --release && trunk build --release && astro build && python scripts/optimize-assets.py",
    "validate": "ts-node scripts/validate-data.ts && cargo run --bin hash-integrity",
    "test": "vitest && playwright test && cargo test",
    "lint": "eslint . --ext .ts,.tsx,.astro && stylelint '**/*.css'",
    "a11y-check": "ts-node scripts/a11y-check.ts",
    "perf-budget": "ts-node scripts/perf-budget.ts",
    "generate-diagrams": "ts-node scripts/generate-diagrams.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^3.5.0",
    "ajv": "^8.17.1",
    "astro": "^4.13.1",
    "mermaid": "^10.9.1",
    "preact": "^10.23.1",
    "tailwindcss": "^3.4.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.0",
    "eslint": "^9.9.0",
    "lighthouse": "^12.2.0",
    "playwright": "^1.46.1",
    "postcss": "^8.4.41",
    "stylelint": "^16.8.1",
    "stylelint-config-standard": "^36.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}